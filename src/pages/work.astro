---
import BaseLayout from '../layouts/BaseLayout.astro';
const areas = [
 {id:'delivery', number:'01', category:'DEVOPS / DELIVERY', title:'A better path to production', description:'I care about delivery systems that help engineers move confidently: clear feedback, reversible changes, and automation that makes the right path easy.', topics:['Release engineering','Developer experience','Automation']},
 {id:'reliability', number:'02', category:'INFRASTRUCTURE / RELIABILITY', title:'Systems you can reason about', description:'Dependable infrastructure starts with an understanding of how things fail. My interests include observability, resilient architecture, and the operational habits that turn signals into decisions.', topics:['Observability','Platform engineering','Operational clarity']},
 {id:'ai', number:'03', category:'PRACTICAL AI', title:'Useful intelligence, thoughtfully applied', description:'I’m exploring where AI can improve engineering workflows, with attention to evaluation, useful feedback, and the judgment that remains with the people operating the system.', topics:['Engineering workflows','Evaluation','Human judgment']}
];
---
<BaseLayout title="Work — Riyaz Shaik"><section class="page-intro shell"><p class="eyebrow">AREAS OF WORK</p><h1>The work beneath<br />the product.</h1><p>Infrastructure, delivery, and practical AI—the foundations I focus on when building and operating dependable systems.</p></section><section class="section shell work-list">{areas.map(area => <article id={area.id} class="work-detail"><span class="detail-number">{area.number}</span><div><p class="eyebrow">{area.category}</p><h2>{area.title}</h2><p>{area.description}</p><ul class="tags">{area.topics.map(topic => <li>{topic}</li>)}</ul></div><aside><span class="status-label">RELATED WRITING</span><p><a class="text-link" href={area.id === 'reliability' ? '/writing/taking-an-mcp-service-from-prototype-to-production/' : '/writing/making-ai-useful-across-the-engineering-lifecycle/'}>{area.id === 'reliability' ? 'Taking an MCP Service from Prototype to Production' : 'Making AI Useful Across the Engineering Lifecycle'}</a></p></aside></article>)}</section><section class="contact-band shell"><div><p class="eyebrow">THE PERSON BEHIND THE WORK</p><h2>Experience meets curiosity.</h2></div><a class="button" href="/experience">View experience <span>↗</span></a></section></BaseLayout>
