---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import EssayFeed from '../components/EssayFeed.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('writing', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6);
const topics = ['Infrastructure', 'DevOps', 'AI engineering'];
---
<BaseLayout pageClass="feed-page">
  <header class="feed-intro"><h1>An engineer’s notebook.</h1><p>Ideas, trade-offs, and lessons from building systems that people depend on.</p></header>
  <nav class="feed-topics" aria-label="Browse writing"><a href="/" aria-current="page">Recent writing</a>{topics.map(topic => <a href={`/writing?topic=${encodeURIComponent(topic)}`}>{topic}</a>)}</nav>
  <div class="mobile-topic-links"><span>Explore topics</span>{topics.map(topic => <a href={`/writing?topic=${encodeURIComponent(topic)}`}>{topic}</a>)}</div>
  <EssayFeed articles={articles} />
  {articles.length === 0 && <p class="empty-state">No articles published.</p>}
  <a class="text-link feed-archive-link" href="/writing">Browse all writing</a>
  <AuthorSidebar slot="sidebar" />
</BaseLayout>
