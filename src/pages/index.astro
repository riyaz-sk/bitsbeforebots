---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SignalField from '../components/SignalField.astro';

const articles = [
  { category: 'INFRASTRUCTURE', title: 'The quiet work of making a platform reliable', excerpt: 'Reliability is less about heroic recovery and more about the small choices that make failure boring.', date: 'May 14, 2026', readingTime: '7 min' },
  { category: 'DEVOPS', title: 'A deployment pipeline should earn your trust', excerpt: 'The habits, guardrails, and feedback loops that turn release automation into a genuine engineering advantage.', date: 'Apr 29, 2026', readingTime: '6 min' },
  { category: 'AI ENGINEERING', title: 'Use AI where the signal is strongest', excerpt: 'A practical framework for finding AI use cases that help teams move faster without adding fragile complexity.', date: 'Apr 06, 2026', readingTime: '8 min' }
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> RIYAZ SHAIK · PRINCIPAL DEVOPS ENGINEER, ORACLE</p>
    <h1>Practical notes for<br /><em>people who build.</em></h1></div>
    <SignalField />
    <div class="hero-bottom">
      <p>Bits Before Bots is where I share field notes on reliable infrastructure, platform engineering, and AI that earns its place.</p>
      <div class="hero-actions"><a class="button button--dark" href="#start-here">Start here <span>↓</span></a><a class="text-link" href="/experience">My experience →</a></div>
    </div>
    <div class="hero-coordinates" aria-hidden="true">39.7392° N&nbsp;&nbsp;104.9903° W<br />BUILD / LEARN / SHARE</div>
  </section>

  <section class="content-section wayfinding" id="start-here">
    <div class="section-heading"><p class="eyebrow">A QUICK ORIENTATION</p><h2>Find your signal.</h2></div>
    <p class="section-lede">Start with the part of engineering you care about most. Every note is written for people making real systems work in the real world.</p>
    <div class="path-grid">
      <a href="/writing#infrastructure"><span>01</span><h3>Infrastructure</h3><p>Reliable foundations, cloud architecture, and the calm work behind uptime.</p><b>Explore →</b></a>
      <a href="/writing#devops"><span>02</span><h3>DevOps &amp; Platform</h3><p>Better delivery systems, developer experience, and operational feedback loops.</p><b>Explore →</b></a>
      <a href="/writing#ai"><span>03</span><h3>AI Engineering</h3><p>Useful AI patterns with a focus on signal, safety, and outcomes.</p><b>Explore →</b></a>
      <a href="/writing#software"><span>04</span><h3>Software Craft</h3><p>Design decisions, technical judgment, and systems that age well.</p><b>Explore →</b></a>
    </div>
  </section>

  <section class="content-section featured-section">
    <div class="section-heading"><p class="eyebrow">IF YOU READ ONE THING</p><h2>Begin with this.</h2><a href="/writing">All writing →</a></div>
    <div class="featured-reading">
      <ArticleCard {...articles[0]} featured={true} />
      <div class="reading-note"><p class="eyebrow">THE THROUGH LINE</p><h3>Good engineering makes the right thing easier to do.</h3><p>From incident response to AI adoption, I care about reducing fragility and creating room for teams to think.</p><a class="text-link" href="/about">Why I write →</a></div>
    </div>
  </section>

  <section class="proof-band">
    <div><p class="eyebrow">IN PRACTICE</p><h2>Platform thinking,<br />close to the work.</h2></div>
    <div class="proof-role"><span>NOW</span><strong>Principal DevOps Engineer</strong><p>Oracle · Building systems that are easier to ship, operate, and trust.</p><a class="text-link" href="/experience">View experience →</a></div>
  </section>

  <section class="about-band">
    <div class="identity-stamp" aria-hidden="true"><span>RS</span><i>∞</i></div>
    <p class="eyebrow">THE PERSON BEHIND THE NOTES</p>
    <div><h2>Curious about the systems beneath the product.</h2><p>Riyaz Shaik · Principal DevOps Engineer at Oracle. I write about the work of making complex software simpler, safer, and easier to operate.</p><a class="button button--light" href="/about">More about me <span>→</span></a></div>
  </section>
</BaseLayout>
