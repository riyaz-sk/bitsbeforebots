---
import BaseLayout from '../layouts/BaseLayout.astro';
const articles = [
  { art: 'bars', title: 'Observability that matters: signals, not noise', description: 'Focus on the few measurements that tell the truth. Build dashboards that illuminate, not decorate.', date: 'Apr 28, 2026', time: '6 min read' },
  { art: 'wedge', title: 'Git workflows for calm deployments', description: 'Trunk-based thinking, small batches, and safe rollouts. A workflow that keeps teams shipping without fear.', date: 'Apr 14, 2026', time: '5 min read' },
  { art: 'rings', title: 'Prompting as engineering, not magic', description: 'Structure, context, and evaluation. A practical approach to building reliable AI-powered features.', date: 'Mar 31, 2026', time: '7 min read' }
];
---
<BaseLayout title="Bits Before Bots — Field Notes">
  <main class="journal-home">
    <section class="journal-hero"><h1>Field notes for<br /><span>reliable systems.</span></h1><nav class="topic-nav" aria-label="Writing topics"><a href="/writing#infrastructure">Infrastructure</a><a href="/writing#devops">DevOps</a><a href="/writing#ai">AI Engineering</a><a href="/writing#software">Software Craft</a></nav></section>
    <section class="journal-feature"><div class="feature-art" aria-hidden="true"><div class="feature-sun"></div><div class="feature-hill"></div><div class="feature-paper"></div><div class="feature-dots"></div><div class="feature-lines"></div></div><article class="feature-copy"><p class="feature-label note-script">Featured</p><h2>Designing for failure:<br />practical resilience patterns<br />that actually work</h2><p>Failure is inevitable. Resilience is a design choice. A field guide to patterns that help systems absorb shock, degrade gracefully, and recover cleanly.</p><div class="byline"><strong>Riyaz Shaik</strong><span>•</span><span>May 12, 2026</span><span>•</span><span>8 min read</span></div></article></section>
    <section class="journal-list" aria-label="Latest articles">{articles.map(article => <article class="journal-row"><div class:list={['row-art', `row-art--${article.art}`]} aria-hidden="true"><i></i><b></b></div><div class="row-copy"><h2>{article.title}</h2><p>{article.description}</p></div><div class="row-meta"><strong>Riyaz Shaik</strong><span>{article.date} · {article.time}</span></div><a class="row-arrow" href="/writing" aria-label={`Read ${article.title}`}>→</a></article>)}</section>
    <footer class="journal-quote"><span class="quote-mark">“</span><p>Tools change. Systems last. Build with clarity, measure honestly, and leave things better than you found them.<br /><i>— Riyaz Shaik</i></p><span class="quote-menu" aria-hidden="true"><b></b><b></b><b></b></span></footer>
  </main>
</BaseLayout>
