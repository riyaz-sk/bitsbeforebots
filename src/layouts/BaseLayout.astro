---
import '../styles/global.css';
import '../styles/journal-overrides.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bits Before Bots',
  description = 'Infrastructure, DevOps, AI, and practical software engineering.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'is-journal-home': Astro.url.pathname === '/' }}>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Bits Before Bots home">
        <span class="mark mark--split"><svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7"/><path d="M8 6v20h6c6 0 9-3 9-7 0-3-2-5-5-6 3-1 4-3 4-6 0-4-3-7-8-7H8Zm5 5h3c2 0 3 1 3 2s-1 2-3 2h-3v-4Zm0 9h4c2 0 3 1 3 3s-1 3-3 3h-4v-6Z"/><path d="M21 6v20h-7c3-2 4-4 4-7 0-3-1-5-3-6 2-1 3-3 3-5 0-3-1-5-3-6 1-1 3-1 6-1Z"/></svg></span><span>bitsbeforebots</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/writing">Writing</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
        <span aria-hidden="true">◐</span>
      </button>
    </header>
    <div class="reading-line" aria-hidden="true"><span data-reading-line></span></div>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="wordmark" href="/"><span class="mark mark--split"><svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7"/><path d="M8 6v20h6c6 0 9-3 9-7 0-3-2-5-5-6 3-1 4-3 4-6 0-4-3-7-8-7H8Zm5 5h3c2 0 3 1 3 2s-1 2-3 2h-3v-4Zm0 9h4c2 0 3 1 3 3s-1 3-3 3h-4v-6Z"/><path d="M21 6v20h-7c3-2 4-4 4-7 0-3-1-5-3-6 2-1 3-3 3-5 0-3-1-5-3-6 1-1 3-1 6-1Z"/></svg></span><span>bitsbeforebots</span></a>
      <p>Built for thoughtful systems.</p>
      <div class="footer-links">
        <a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/ririshai/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="mailto:hello@bitsbeforebots.com">Email ↗</a>
      </div>
    </footer>
    <script is:inline>
      const storedTheme = localStorage.getItem('bbb-theme');
      if (storedTheme) document.documentElement.dataset.theme = storedTheme;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('bbb-theme', next);
      });
      const line = document.querySelector('[data-reading-line]');
      addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (line) line.style.transform = `scaleX(${max ? scrollY / max : 0})`;
      }, { passive: true });
    </script>
  </body>
</html>
