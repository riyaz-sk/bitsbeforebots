---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
interface Props { title?: string; description?: string; pageClass?: string; }
const { pageClass = '', title = 'Riyaz Shaik — Bits Before Bots', description = 'Riyaz Shaik, Sr. Principal DevOps Engineer. Infrastructure, reliable systems, practical AI, and engineering field notes.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home', icon: 'M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z' },
  { href: '/writing', label: 'Writing', icon: 'M4 4h7a3 3 0 0 1 3 3v14a4 4 0 0 0-4-2H4Zm16 0h-3M20 8h-3M20 12h-3M20 16h-3' },
  { href: '/work', label: 'Work', icon: 'M8 6V4h8v2M3 7h18v14H3ZM3 12h18M10 12v3h4v-3' },
  { href: '/experience', label: 'Experience', icon: 'M4 21V11h4v10M10 21V7h4v14M16 21V3h4v18' },
  { href: '/about', label: 'About', icon: 'M20 21v-3a5 5 0 0 0-5-5H9a5 5 0 0 0-5 5v3M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0' }
];
const hasSidebar = Astro.slots.has('sidebar');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      try { const theme = localStorage.getItem('bbb-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body class:list={[pageClass, "reading-app"]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="app-header">
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <a class="wordmark" href="/" aria-label="Bits Before Bots home"><span class="brand-mark" aria-hidden="true">b<span>b</span><i></i></span><span>bitsbeforebots<span class="brand-caption">RIYAZ SHAIK / ENGINEER &amp; WRITER</span></span></a>
      <form class="site-search" action="/writing" role="search">
        <label class="sr-only" for="article-search">Search articles</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
        <input id="article-search" name="q" type="search" placeholder="Search the notebook" autocomplete="off" />
        <button type="submit" aria-label="Search articles">↵</button>
      </form>
      <button class="theme-toggle" type="button" aria-label="Switch color theme" data-theme-toggle><span aria-hidden="true">◐</span></button>
    </header>
    <div class="app-frame">
      <aside class="navigation-rail" id="site-navigation">
        <nav aria-label="Primary navigation">
          {nav.map(({href, label, icon}) => <a href={href} aria-current={(href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href)) ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon}/></svg><span>{label}</span></a>)}
        </nav>
        <div class="rail-note"><span class="tiny-dot"></span><p>Less hype.<br />More understanding.</p></div>
      </aside>
      <div class="app-body">
        <div class:list={['reading-columns', {'has-sidebar': hasSidebar}]}>
          <main id="main"><slot /></main>
          {hasSidebar && <aside class="discovery-rail" aria-label="About the author and topics"><slot name="sidebar" /></aside>}
        </div>
        <footer class="site-footer"><div><a class="footer-name" href="/">Bits before bots.</a><p>Thoughtful systems. Useful ideas. Always learning.</p></div><div class="footer-links"><SocialLinks /><span>© {new Date().getFullYear()} Riyaz Shaik</span></div></footer>
      </div>
    </div>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      if (menu) { menu.hidden = false; document.body.classList.add('navigation-ready'); }
      const closeMenu = () => { document.body.classList.remove('navigation-open'); menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open navigation'); };
      menu?.addEventListener('click', () => {
        const open = document.body.classList.toggle('navigation-open');
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });
      addEventListener('keydown', event => { if (event.key === 'Escape' && document.body.classList.contains('navigation-open')) { closeMenu(); menu?.focus(); } });
      matchMedia('(min-width: 901px)').addEventListener('change', closeMenu);
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const preference = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : preference.matches;
      const updateLabel = () => toggle?.setAttribute('aria-label', `Switch to ${isDark() ? 'light' : 'dark'} theme`);
      updateLabel(); preference.addEventListener('change', updateLabel);
      toggle?.addEventListener('click', () => { const next = isDark() ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('bbb-theme', next); } catch {} updateLabel(); });
    </script>
  </body>
</html>
